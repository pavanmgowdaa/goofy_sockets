# Server
PORT=3000

# WhatsApp OTP delivery (default: console). This project has no live WhatsApp
# provider integration. META_PHONE_NUMBER_ID and WHATSAPP_API_TOKEN are optional
# and intentionally disabled unless you add and fund an approved delivery integration.
WHATSAPP_OTP_MODE=console
WHATSAPP_OTP_WEBHOOK_URL=
DEMO_OTP=
OTP_TTL_SECONDS=300

# Application protection
OTP_REQUESTS_PER_15_MIN=5
CAPTCHA_VERIFY_URL=
QUEUE_TOKEN_SECRET=

# Blockchain adapter (mock is the safe default)
BLOCKCHAIN_MODE=mock
QUAI_RPC_URL=
QUAI_CHAIN_ID=
QUAI_CONTRACT_ADDRESS=
QUAI_PRIVATE_KEY=
